# pi4j-bench runtime config — shipped with the binary, passed at run time.
#   ./bench --config bench.config …            # explicit
#   ./bench …                                  # auto: bench.config next to the binary/bundle
# Every key is optional; unset keys keep the built-in defaults shown below (the mock wiring).
# A native image has no JDK of its own, so on those hosts set `jdk` (or keep JDK 25 on PATH).

# --- JDK used to fork the measurement lanes (a real JIT JDK 25; not the native image) -----
# jdk = /opt/jdk-25
# jdk = /home/pi/.sdkman/candidates/java/25-amzn

# --- run options (mirror the CLI flags; a CLI flag always overrides the value here) --------
# run.gc       = g1            # applied to EVERY fork: g1|zgc|parallel|serial|shenandoah|epsilon
# run.quick    = false         # 1 JMH fork + short latency/memory windows (smoke test)
# run.jfr      = false         # attach JFR to the latency lane
# run.cpus     = 2,3           # taskset -c core list for every measurement fork
# run.profilers = gc           # extra JMH profilers (comma list)
# run.jhiccup  = /opt/jHiccup.jar
# run.lane     = mock          # mock | hw
# run.lanes    = v4-jmh,v3-jmh,memory-fixed,memory-issue628,latency-v4,warmup-v4
#                              # which lanes to run, in THIS order (default: all, canonical order)
# run.native   = false         # include the GraalVM native-image latency lane if its binary is present
# run.leyden.jdk = /opt/leyden-ea-jdk   # optional: the FFM-warmup Leyden EA variant (skipped if unset)
# run.gcs      = g1,zgc        # GC SWEEP: run the whole matrix once per collector, each into
#                              #   results/<arch>/<lane>/<timestamp>/<gc>/ (CLI: --gc-matrix)
# run.gc-pressure = false      # background allocator during the latency lane (CLI: --gc-pressure)
# run.gc-pressure-mbps = 200   # its target churn rate in MB/s
# run.preset   = gc-sweep      # apply a preset.<name>.* block below (CLI: --preset gc-sweep)

# --- presets: named bundles of run options ------------------------------------------------
# Select one with `--preset <name>` (or run.preset). A preset overrides the plain run.*
# values above, but any explicit CLI flag still wins over the preset. Recognised keys mirror
# the run.* options WITHOUT the prefix: gcs, lanes, quick, cpus, jfr, profilers, gc-pressure,
# gc-pressure-mbps, gc, lane, native, leyden.jdk.
#
# "gc-sweep": the full matrix once per collector (the results/<ts>/<gc>/ layout).
preset.gc-sweep.gcs   = g1,zgc,parallel,serial
#
# "latency-gc": just the latency lane, swept across the two collectors that matter for tails.
preset.latency-gc.gcs   = g1,zgc
preset.latency-gc.lanes = latency-v4
#
# "latency-pressure": the same, but with the background allocator on — exposes which collector
# owns p99.9 under load (plan §6.3: {idle, GC-pressure 200 MB/s} × {G1, ZGC}).
preset.latency-pressure.gcs          = g1,zgc
preset.latency-pressure.lanes        = latency-v4
preset.latency-pressure.gc-pressure  = true
preset.latency-pressure.gc-pressure-mbps = 200

# --- which mock interfaces the shared latency/memory lanes need pre-loaded ----------------
mock.ifaces = gpio,i2c

# --- load-verification node per interface (the file whose appearance proves the mock is up)
mock.gpio.node = /sys/kernel/debug/gpio-mock/accessible/line3
mock.i2c.node  = /dev/i2c-99

# --- peripheral addressing (bench.*), passed to EVERY lane as -D and read via BenchProps ---
# On --lane hw, point these at real peripherals instead of the mock defaults below.
bench.i2c.bus          = 99
bench.i2c.device       = 0x1C
bench.i2c.register     = 0xFF
# GPIO via the V4/FFM provider (chip "bus" + BCM line):
bench.gpio.bus         = 97
bench.gpio.in.bcm      = 3
bench.gpio.out.bcm     = 5
bench.gpio.label.ffm   = accessible
# GPIO via the V3 gpiod provider (chip name + line address) and the latency stimulus label:
bench.gpiod.chip       = gpiochip0
bench.gpiod.in.address = 3
bench.gpiod.out.address = 5
bench.gpio.label.gpiod = pinctrl-mock
# SPI (bus number → SpiBus.BUS_n) and channel; PWM chip/channel:
bench.spi.bus          = 6
bench.spi.channel      = 0
# PWM chip: 'auto' discovers the chip owned by the pwm-mock driver (its index depends on how
# many controllers the board registered first — it is NOT 0 on a Milk-V Mars). On --lane hw
# pin the real controller by number instead, and set the polarity its driver accepts.
bench.pwm.chip         = auto
bench.pwm.channel      = 0
# bench.pwm.mock.driver = pwm-mock   # driver name auto-discovery looks for
# bench.pwm.polarity    = normal     # normal | inversed (some SoC drivers reject 'normal')
# V3 linuxfs sysfs GPIO base path + line offset added to the discovered chip base. The base
# is handed out by the kernel, so the chip is located by its exact label and the resulting
# line is checked to be exported before use. Offset 2 is deliberately unused: the mock hogs
# that line (GPIO_MOCK_HOGS), and a hogged line cannot be exported ("Device or resource busy").
bench.linuxfs.path       = /sys/class/gpio/
bench.linuxfs.label      = linuxfs-mock
bench.linuxfs.offset     = 0
bench.linuxfs.out.offset = 1
